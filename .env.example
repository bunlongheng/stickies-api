# Required. The process refuses to start without these.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
AUTH_SECRET="a long random string, signs the access and refresh tokens"

# Postgres TLS. Raw PEM or base64. Production refuses to connect without it.
DATABASE_CA_CERT=""

PORT=4446
NODE_ENV=development
APP_BASE_URL="http://localhost:4446"
# Origins allowed to send credentialed browser requests.
CORS_ORIGINS="http://localhost:3000,http://localhost:4444"

# Single-user app: only this address may sign in.
OWNER_EMAIL=""
# The legacy id every existing note is filed under.
OWNER_USER_ID=""

# Google sign-in, for both the web app and the native app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The shared bearer the existing scripts and agents use.
STICKIES_API_KEY=""
# Lock the deployment down to a single api_keys label.
STICKIES_PROD_LOCK="0"
STICKIES_PROD_KEY_LABEL=""
# Keyless LAN owner access. Only the hub sets this in production.
STICKIES_LAN_TRUST="0"

# Integrations. Each one is optional, its routes report 503 without it.
ANTHROPIC_API_KEY=""
HUE_INTERNAL_BASE_URL="http://127.0.0.1:4444"
GITHUB_BACKUP_TOKEN=""
STICKIES_BUILD_ID=""
